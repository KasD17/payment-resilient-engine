	"item": [
		{
			"name": "Payments",
			"item": [
				{
					"name": "1. Charge Customer (New Idempotency Key)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.request.headers.upsert({",
									"    key: 'Idempotency-Key',",
									"    value: pm.variables.replaceIn('{{$guid}}')",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customer_id\": \"00000000-0000-0000-0000-000000000001\",\n    \"amount\": 5000,\n    \"currency\": \"USD\",\n    \"payment_method_id\": \"pm_card_visa\",\n    \"description\": \"API One-Time Charge Demo\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/payments/charge",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"payments",
								"charge"
							]
						}
					},
					"response": []
